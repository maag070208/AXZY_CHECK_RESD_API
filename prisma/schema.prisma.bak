generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String    @id @default(uuid())
  name      String    @unique
  value     String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  updatedAt DateTime  @updatedAt
  users     User[]
}

model Zone {
  id         String     @id @default(uuid())
  name       String
  active     Boolean    @default(true)
  softDelete Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  locations  Location[]

}

model User {
  id                      String                   @id @default(uuid())
  name                    String
  lastName                String?
  username                String                   @unique
  password                String
  active                  Boolean                  @default(true)
  softDelete              Boolean                  @default(false)
  shiftStart              String?
  shiftEnd                String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  isLoggedIn              Boolean                  @default(false)
  scheduleId              String?
  roleId                  String
  deletedAt               DateTime?
  createdAssignments      Assignment[]             @relation("AssignedByAssignments")
  assignments             Assignment[]             @relation("GuardAssignments")
  assignmentLogs          AssignmentLog[]
  auditLogs               AuditLog[]
  incidents               Incident[]
  resolvedIncidents       Incident[]               @relation("IncidentResolver")
  kardexEntries           Kardex[]
  maintenances            Maintenance[]
  resolvedMaintenances    Maintenance[]            @relation("MaintenanceResolver")
  rounds                  Round[]                  @relation("GuardRounds")
  role                    Role                     @relation(fields: [roleId], references: [id])
  schedule                Schedule?                @relation(fields: [scheduleId], references: [id])
  recurringConfigurations RecurringConfiguration[] @relation("RecurringConfigurationToUser")
}

model AssignmentLog {
  id        String   @id @default(uuid())
  guardId   String
  type      String
  notes     String?
  createdAt DateTime @default(now())
  guard     User     @relation(fields: [guardId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  module     String
  action     String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Schedule {
  id        String    @id @default(uuid())
  name      String    @unique
  startTime String
  endTime   String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  users     User[]
}

model Location {
  id                 String              @id @default(uuid())
  aisle              String?
  spot               String?
  number             String?
  name               String
  isOccupied         Boolean             @default(false)
  active             Boolean             @default(true)
  softDelete         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reference          String?
  zoneId             String?
  deletedAt          DateTime?
  assignments        Assignment[]
  kardexEntries      Kardex[]
  zone               Zone?               @relation(fields: [zoneId], references: [id])
  tasks              LocationTask[]
  recurringLocations RecurringLocation[]

  @@unique([name, zoneId])
}

model LocationTask {
  id          String    @id @default(uuid())
  locationId  String
  description String
  reqPhoto    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime  @updatedAt
  location    Location  @relation(fields: [locationId], references: [id])
}

model Kardex {
  id           String      @id @default(uuid())
  userId       String
  locationId   String
  timestamp    DateTime    @default(now())
  notes        String?
  media        Json?
  latitude     Float?
  longitude    Float?
  assignmentId String?
  scanType     ScanType    @default(FREE)
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime    @updatedAt
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  location     Location    @relation(fields: [locationId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([locationId])
  @@index([timestamp])
}

model Assignment {
  id             String           @id @default(uuid())
  guardId        String
  locationId     String
  status         AssignmentStatus @default(PENDING)
  assignedBy     String
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  assignedByUser User             @relation("AssignedByAssignments", fields: [assignedBy], references: [id])
  guard          User             @relation("GuardAssignments", fields: [guardId], references: [id])
  location       Location         @relation(fields: [locationId], references: [id])
  tasks          AssignmentTask[]
  kardex         Kardex[]

  @@index([guardId])
  @@index([locationId])
}

model AssignmentTask {
  id           String     @id @default(uuid())
  assignmentId String
  description  String
  reqPhoto     Boolean    @default(false)
  completed    Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
}

model IncidentCategory {
  id           String         @id @default(uuid())
  name         String         @unique
  value        String
  color        String?
  icon         String?
  type         String         @default("INCIDENT")
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime       @updatedAt
  incidents    Incident[]
  types        IncidentType[]
  maintenances Maintenance[]
}

model IncidentType {
  id           String           @id @default(uuid())
  categoryId   String
  name         String           @unique
  value        String
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime         @updatedAt
  incidents    Incident[]
  category     IncidentCategory @relation(fields: [categoryId], references: [id])
  maintenances Maintenance[]
}

model Incident {
  id           String            @id @default(uuid())
  guardId      String
  title        String
  description  String?
  media        Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  resolvedAt   DateTime?
  resolvedById String?
  status       IncidentStatus    @default(PENDING)
  categoryId   String?
  typeId       String?
  latitude     Float?
  longitude    Float?
  deletedAt    DateTime?
  category     IncidentCategory? @relation(fields: [categoryId], references: [id])
  guard        User              @relation(fields: [guardId], references: [id])
  resolvedBy   User?             @relation("IncidentResolver", fields: [resolvedById], references: [id])
  type         IncidentType?     @relation(fields: [typeId], references: [id])
}

model Round {
  id                       String                  @id @default(uuid())
  guardId                  String
  startTime                DateTime                @default(now())
  endTime                  DateTime?
  status                   RoundStatus             @default(IN_PROGRESS)
  recurringConfigurationId String?
  createdAt                DateTime                @default(now())
  deletedAt                DateTime?
  updatedAt                DateTime                @updatedAt
  guard                    User                    @relation("GuardRounds", fields: [guardId], references: [id])
  recurringConfiguration   RecurringConfiguration? @relation(fields: [recurringConfigurationId], references: [id])
}

model SysConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RecurringConfiguration {
  id                 String              @id @default(uuid())
  title              String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  softDelete         Boolean             @default(false)
  deletedAt          DateTime?
  recurringLocations RecurringLocation[]
  rounds             Round[]
  guards             User[]              @relation("RecurringConfigurationToUser")
}

model RecurringLocation {
  id                       String                 @id @default(uuid())
  locationId               String
  order                    Int                    @default(0)
  recurringConfigurationId String
  createdAt                DateTime               @default(now())
  deletedAt                DateTime?
  updatedAt                DateTime               @updatedAt
  location                 Location               @relation(fields: [locationId], references: [id])
  recurringConfiguration   RecurringConfiguration @relation(fields: [recurringConfigurationId], references: [id])
  tasks                    RecurringTask[]
}

model RecurringTask {
  id                  String            @id @default(uuid())
  recurringLocationId String
  description         String
  reqPhoto            Boolean           @default(false)
  createdAt           DateTime          @default(now())
  deletedAt           DateTime?
  updatedAt           DateTime          @updatedAt
  recurringLocation   RecurringLocation @relation(fields: [recurringLocationId], references: [id])
}

model Maintenance {
  id           String            @id @default(uuid())
  guardId      String
  title        String
  category     String?
  description  String?
  media        Json?
  status       MaintenanceStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  latitude     Float?
  longitude    Float?
  categoryId   String?
  typeId       String?
  deletedAt    DateTime?
  categoryRel  IncidentCategory? @relation(fields: [categoryId], references: [id])
  guard        User              @relation(fields: [guardId], references: [id])
  resolvedBy   User?             @relation("MaintenanceResolver", fields: [resolvedById], references: [id])
  type         IncidentType?     @relation(fields: [typeId], references: [id])
}

  id                     String                   @id
  name                   String                   @unique
  address                String?
  rfc                    String?
  contactName            String?
  contactPhone           String?
  active                 Boolean                  @default(true)
  softDelete             Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  deletedAt              DateTime?
  AssignmentLog          AssignmentLog[]
  Incident               Incident[]
  Location               Location[]
  Maintenance            Maintenance[]
  RecurringConfiguration RecurringConfiguration[]
  Round                  Round[]
  User                   User[]
  Zone                   Zone[]
}

enum AssignmentStatus {
  PENDING
  CHECKING
  UNDER_REVIEW
  REVIEWED
  ANOMALY
}

enum ScanType {
  ASSIGNMENT
  RECURRING
  FREE
}

enum IncidentStatus {
  PENDING
  ATTENDED
}

enum RoundStatus {
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceStatus {
  PENDING
  ATTENDED
}
