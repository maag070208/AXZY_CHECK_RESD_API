generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccessType {
  TEMPORARY
  RECURRING
  DELIVERY
  SERVICE
}

enum AccessStatus {
  PENDING
  ACTIVE
  FINISHED
  EXPIRED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

enum NotificationType {
  GENERAL
  ACCESS
  PAYMENT
  COMPLAINT
  EMERGENCY
}

enum AssignmentStatus {
  PENDING
  CHECKING
  UNDER_REVIEW
  REVIEWED
  ANOMALY
}

enum ScanType {
  ASSIGNMENT
  RECURRING
  FREE
}

enum IncidentStatus {
  PENDING
  ATTENDED
}

enum RoundStatus {
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceStatus {
  PENDING
  ATTENDED
}

model Role {
  id        String    @id @default(uuid())
  name      String    @unique
  value     String
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model User {
  id         String    @id @default(uuid())
  name       String
  lastName   String?
  username   String    @unique
  password   String
  active     Boolean   @default(true)
  softDelete Boolean   @default(false)
  shiftStart String?
  shiftEnd   String?
  isLoggedIn Boolean   @default(false)
  roleId     String
  scheduleId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  role                    Role                     @relation(fields: [roleId], references: [id])
  schedule                Schedule?                @relation(fields: [scheduleId], references: [id])
  assignments             Assignment[]             @relation("GuardAssignments")
  createdAssignments      Assignment[]             @relation("AssignedByAssignments")
  incidents               Incident[]
  resolvedIncidents       Incident[]               @relation("IncidentResolver")
  kardexEntries           Kardex[]
  maintenances            Maintenance[]
  resolvedMaintenances    Maintenance[]            @relation("MaintenanceResolver")
  rounds                  Round[]                  @relation("GuardRounds")
  recurringConfigurations RecurringConfiguration[]
  assignmentLogs          AssignmentLog[]
  auditLogs               AuditLog[]
  residents               Resident[]
  accessLogs              AccessLog[]              @relation("GuardAccessLogs")
  resolvedComplaints      Complaint[]              @relation("ComplaintResolver")
  notifications           Notification[]
  sessions                UserSession[]
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  loginAt   DateTime  @default(now())
  logoutAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  module     String
  action     String
  resourceId String?
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model House {
  id        String    @id @default(uuid())
  number    String
  street    String
  block     String?
  reference String?
  latitude  Float?
  longitude Float?
  occupied  Boolean   @default(false)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  residents Resident[]
  vehicles  Vehicle[]

  @@unique([number, street, block])
}

model Resident {
  id        String    @id @default(uuid())
  userId    String
  houseId   String
  phone     String?
  email     String?
  isOwner   Boolean   @default(false)
  active    Boolean   @default(true)
  stripeCustomerId String? @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user        User              @relation(fields: [userId], references: [id])
  house       House             @relation(fields: [houseId], references: [id])
  contacts    ResidentContact[]
  accesses    Access[]
  complaints  Complaint[]
  payments    Payment[]
  paymentLogs PaymentLog[]
  subscriptions ResidentSubscription[]
  residentFees ResidentFee[]
}

model ResidentContact {
  id                String    @id @default(uuid())
  residentId        String
  name              String
  phone             String?
  email             String?
  relationship      String
  canGenerateAccess Boolean   @default(false)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  resident Resident @relation(fields: [residentId], references: [id])
}

model Vehicle {
  id        String    @id @default(uuid())
  houseId   String
  plate     String    @unique
  brand     String?
  model     String?
  color     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  house House @relation(fields: [houseId], references: [id])
}

model Visitor {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accesses Access[]
}

model Access {
  id         String       @id @default(uuid())
  residentId String
  visitorId  String
  type       AccessType
  status     AccessStatus @default(PENDING)
  qrCode     String?      @unique
  validFrom  DateTime
  validUntil DateTime
  used       Boolean      @default(false)
  rejectionReason String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  resident   Resident    @relation(fields: [residentId], references: [id])
  visitor    Visitor     @relation(fields: [visitorId], references: [id])
  accessLogs AccessLog[]
}

model AccessLog {
  id        String    @id @default(uuid())
  accessId  String
  guardId   String
  entryTime DateTime  @default(now())
  exitTime  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  access Access @relation(fields: [accessId], references: [id])
  guard  User   @relation("GuardAccessLogs", fields: [guardId], references: [id])
}

model ComplaintCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[]
}

model Complaint {
  id           String          @id @default(uuid())
  residentId   String
  categoryId   String
  title        String
  description  String
  media        Json?
  status       ComplaintStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  resident   Resident          @relation(fields: [residentId], references: [id])
  category   ComplaintCategory @relation(fields: [categoryId], references: [id])
  resolvedBy User?             @relation("ComplaintResolver", fields: [resolvedById], references: [id])
}

enum FeeType {
  ONE_TIME
  MONTHLY
}

model Fee {
  id          String    @id @default(uuid())
  name        String
  description String?
  amount      Decimal
  type        FeeType   @default(ONE_TIME)
  dueDate     DateTime
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  payments      Payment[]
  residentFees ResidentFee[]
}

model ResidentFee {
  id         String    @id @default(uuid())
  residentId String
  feeId      String
  active     Boolean   @default(true)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  resident Resident @relation(fields: [residentId], references: [id])
  fee      Fee      @relation(fields: [feeId], references: [id])

  @@unique([residentId, feeId, deletedAt])
}

model SubscriptionPlan {
  id            String    @id @default(uuid())
  name          String
  description   String?
  amount        Decimal
  stripePriceId String    @unique
  active        Boolean   @default(true)
  interval      String    @default("month")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  subscriptions ResidentSubscription[]
}

model ResidentSubscription {
  id                   String    @id @default(uuid())
  residentId           String
  planId               String
  stripeSubscriptionId String    @unique
  status               String    @default("incomplete")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  resident Resident         @relation(fields: [residentId], references: [id])
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Payment {
  id         String        @id @default(uuid())
  residentId String
  feeId      String
  amount     Decimal
  reference  String?
  status     PaymentStatus @default(PENDING)
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  resident    Resident     @relation(fields: [residentId], references: [id])
  fee         Fee          @relation(fields: [feeId], references: [id])
  paymentLogs PaymentLog[]
}

model PaymentLog {
  id         String         @id @default(uuid())
  paymentId  String?
  residentId String
  action     String
  statusFrom PaymentStatus?
  statusTo   PaymentStatus
  amount     Decimal
  notes      String?
  createdAt  DateTime       @default(now())

  payment  Payment? @relation(fields: [paymentId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Zone {
  id         String    @id @default(uuid())
  name       String    @unique
  active     Boolean   @default(true)
  softDelete Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  locations Location[]
}

model AssignmentLog {
  id        String   @id @default(uuid())
  guardId   String
  type      String
  notes     String?
  createdAt DateTime @default(now())

  guard User @relation(fields: [guardId], references: [id])
}

model Schedule {
  id        String    @id @default(uuid())
  name      String    @unique
  startTime String
  endTime   String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users User[]
}

model Location {
  id         String    @id @default(uuid())
  zoneId     String?
  aisle      String?
  spot       String?
  number     String?
  name       String
  reference  String?
  isOccupied Boolean   @default(false)
  active     Boolean   @default(true)
  softDelete Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  zone               Zone?               @relation(fields: [zoneId], references: [id])
  tasks              LocationTask[]
  assignments        Assignment[]
  kardexEntries      Kardex[]
  recurringLocations RecurringLocation[]

  @@unique([name, zoneId])
}

model LocationTask {
  id          String    @id @default(uuid())
  locationId  String
  description String
  reqPhoto    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  location Location @relation(fields: [locationId], references: [id])
}

model Kardex {
  id           String    @id @default(uuid())
  userId       String
  locationId   String
  timestamp    DateTime  @default(now())
  notes        String?
  media        Json?
  latitude     Float?
  longitude    Float?
  assignmentId String?
  scanType     ScanType  @default(FREE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assignment Assignment? @relation(fields: [assignmentId], references: [id])
  location   Location    @relation(fields: [locationId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
}

model Assignment {
  id         String           @id @default(uuid())
  guardId    String
  locationId String
  status     AssignmentStatus @default(PENDING)
  assignedBy String
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  assignedByUser User?            @relation("AssignedByAssignments", fields: [assignedBy], references: [id])
  guard          User             @relation("GuardAssignments", fields: [guardId], references: [id])
  location       Location         @relation(fields: [locationId], references: [id])
  tasks          AssignmentTask[]
  kardex         Kardex[]
}

model AssignmentTask {
  id           String    @id @default(uuid())
  assignmentId String
  description  String
  reqPhoto     Boolean   @default(false)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
}

model IncidentCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  value     String
  type      String    @default("INCIDENT")
  color     String?
  icon      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  types        IncidentType[]
  incidents    Incident[]
  maintenances Maintenance[]
}

model IncidentType {
  id         String    @id @default(uuid())
  categoryId String
  name       String    @unique
  value      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  category     IncidentCategory @relation(fields: [categoryId], references: [id])
  incidents    Incident[]
  maintenances Maintenance[]
}

model Incident {
  id           String         @id @default(uuid())
  guardId      String
  title        String
  categoryId   String?
  typeId       String?
  description  String?
  media        Json?
  latitude     Float?
  longitude    Float?
  status       IncidentStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  category   IncidentCategory? @relation(fields: [categoryId], references: [id])
  type       IncidentType?     @relation(fields: [typeId], references: [id])
  guard      User              @relation(fields: [guardId], references: [id])
  resolvedBy User?             @relation("IncidentResolver", fields: [resolvedById], references: [id])
}

model Round {
  id                       String      @id @default(uuid())
  guardId                  String
  startTime                DateTime    @default(now())
  endTime                  DateTime?
  status                   RoundStatus @default(IN_PROGRESS)
  recurringConfigurationId String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  deletedAt                DateTime?

  guard                  User                    @relation("GuardRounds", fields: [guardId], references: [id])
  recurringConfiguration RecurringConfiguration? @relation(fields: [recurringConfigurationId], references: [id])
}

model SysConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model RecurringConfiguration {
  id         String    @id @default(uuid())
  title      String
  active     Boolean   @default(true)
  softDelete Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  recurringLocations RecurringLocation[]
  guards             User[]
  rounds             Round[]
}

model RecurringLocation {
  id                       String    @id @default(uuid())
  recurringConfigurationId String
  locationId               String
  order                    Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  recurringConfiguration RecurringConfiguration @relation(fields: [recurringConfigurationId], references: [id])
  location               Location               @relation(fields: [locationId], references: [id])
  tasks                  RecurringTask[]
}

model RecurringTask {
  id                  String    @id @default(uuid())
  recurringLocationId String
  description         String
  reqPhoto            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  recurringLocation RecurringLocation @relation(fields: [recurringLocationId], references: [id])
}

model Maintenance {
  id           String            @id @default(uuid())
  guardId      String
  title        String
  categoryId   String?
  typeId       String?
  category     String?
  description  String?
  media        Json?
  latitude     Float?
  longitude    Float?
  status       MaintenanceStatus @default(PENDING)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  guard       User              @relation(fields: [guardId], references: [id])
  resolvedBy  User?             @relation("MaintenanceResolver", fields: [resolvedById], references: [id])
  categoryRel IncidentCategory? @relation(fields: [categoryId], references: [id])
  type        IncidentType?     @relation(fields: [typeId], references: [id])
}

model ReportConfiguration {
  id             String    @id @default(uuid())
  name           String
  description    String?
  reportType     String
  configuration  Json
  cronExpression String?
  active         Boolean   @default(true)
  softDelete     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}
